{
  "openapi": "3.0.3",
  "info": {
    "title": "Purchase Pin Phone API",
    "description": "Purchase Pin Phone API for Prison Customer.",
    "version": "1.0.0",
    "contact": {
      "name": "HMPPS Digital Studio",
      "email": "feedback@digital.justice.gov.uk"
    }
  },
  "paths": {
    "/api/{cartId}/complete": {
      "post": {
        "summary": "Completes the cart and processes the checkout for PIN Phone credit purchase",
        "parameters": [
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteCartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteCartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/createCart": {
      "post": {
        "summary": "Creates a new cart for the prisoner customer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCartResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCartRequest": {
        "type": "object",
        "required": [
          "prisonId",
          "offenderNo",
          "firstName",
          "lastName"
        ],
        "properties": {
          "prisonId": {
            "type": "string",
            "example": "ABC"
          },
          "offenderNo": {
            "type": "string",
            "example": "A1234BC"
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          }
        }
      },
      "CreateCartResponse": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "example": "CART12345"
          }
        }
      },
      "CompleteCartRequest": {
        "type": "object",
        "required": [
          "offenderNo",
          "amount"
        ],
        "properties": {
          "offenderNo": {
            "type": "string",
            "example": "A1234BC"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "example": 10.0
          }
        }
      },
      "CompleteCartResponse": {
         "type": "object",
         "properties": {
           "order": {
             "type" : "string",
             "example": "order_01KZBKB3PE8N714VE8PY6JH7T9"
           },
           "message": {
             "type": "string",
             "example": "Purchase completed successfully"
           },
           "status": {
             "type": "string",
             "example": "SUCCESS"
           }
         }
       }
     }
   }
 }

