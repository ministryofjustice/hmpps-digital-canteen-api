{
  "openapi": "3.0.3",
  "info": {
    "title": "Upload National Product List API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/national-product-lists/import": {
      "post": {
        "summary": "Import and synchronize National Product List",
        "operationId": "importNationalProductList",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "National Product List uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportNationalProductListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or validation error"
          },
          "500": {
            "description": "Internal server error during synchronization"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImportNationalProductListResponse": {
        "type": "object",
        "required": [
          "recordsCreated",
          "recordsUpdated",
          "recordsDeleted",
          "message"
        ],
        "properties": {
          "recordsCreated": {
            "type": "integer"
          },
          "recordsUpdated": {
            "type": "integer"
          },
          "recordsDeleted": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}