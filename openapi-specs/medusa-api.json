{
  "openapi": "3.0.3",
  "info": {
    "title": "Medusa API",
    "description": "Medusa API specifications",
    "version": "1.0.0",
    "contact": {
      "name": "HMPPS Digital Studio",
      "email": "feedback@digital.justice.gov.uk"
    }
  },
  "paths": {
    "/store/pin-phone/carts": {
      "post": {
        "operationId": "createPinPhoneCart",
        "summary": "Create a PIN phone cart",
        "description": "Creates a new cart for a prisoner's PIN phone purchase.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/store/pin-phone/carts/{id}/add-items": {
      "post": {
        "operationId": "addPinPhoneToCart",
        "summary": "Add PIN phone credit to cart",
        "description": "Adds a PIN phone credit item to the specified cart with the given amount.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" },
            "description": "The cart ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added to cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          },
          "404": {
            "description": "PIN Phone variant not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 404
                    },
                    "errorCode": {
                      "type": "string",
                      "example": "VARIANT_NOT_FOUND"
                    },
                    "userMessage": {
                      "type": "string",
                      "example": "PIN Phone variant not found. Please check the SKU and try again."
                    },
                    "developerMessage": {
                      "type": "string"
                    },
                    "moreInfo": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to add pin phone to cart",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 500
                    },
                    "errorCode": {
                      "type": "string",
                      "example": "ADD_TO_CART_FAILED"
                    },
                    "userMessage": {
                      "type": "string"
                    },
                    "developerMessage": {
                      "type": "string"
                    },
                    "moreInfo": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/store/pin-phone/carts/{id}/complete": {
      "post": {
        "operationId": "completePinPhoneCart",
        "summary": "Complete a PIN phone cart",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" },
            "description": "The cart ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteCartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart completed or payment failure details returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteCartResponse"
                }
              }
            }
          },
          "400": {
            "description": "No cart items found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCartRequest": {
        "type": "object",
        "required": ["metadata"],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/CartMetadata"
          }
        }
      },
      "CartMetadata": {
        "type": "object",
        "required": ["prison_id", "offender_no", "first_name", "second_name"],
        "properties": {
          "prison_id": {
            "type": "string",
            "description": "The prison identifier",
            "example": "MDI"
          },
          "offender_no": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          },
          "first_name": {
            "type": "string",
            "description": "Prisoner's first name",
            "example": "John"
          },
          "second_name": {
            "type": "string",
            "description": "Prisoner's last name",
            "example": "Smith"
          }
        }
      },
      "AddItemsRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Amount in pence",
            "example": 1000
          }
        }
      },
      "CompleteCartRequest": {
        "type": "object",
        "required": ["PaymentResult"],
        "properties": {
          "PaymentResult": {
            "$ref": "#/components/schemas/PaymentResult"
          }
        }
      },
      "PaymentResult": {
        "type": "object",
        "required": ["offender_no", "status"],
        "properties": {
          "offender_no": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          },
          "status": {
            "type": "string",
            "enum": ["AUTHORIZED", "ERROR", "CANCELLED"],
            "description": "Payment authorisation status"
          },
          "transactionReference": {
            "type": "string",
            "description": "Reference from the payment provider"
          },
          "holdNumber": {
            "type": "integer",
            "description": "The finance hold number"
          },
          "errorCode": {
            "type": "string",
            "description": "Error code if payment failed"
          },
          "errorMessage": {
            "type": "string",
            "description": "Error message if payment failed"
          }
        }
      },
      "CartResponse": {
        "type": "object",
        "properties": {
          "cart": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The cart ID"
              }
            }
          }
        }
      },
      "CompleteCartResponse": {
        "type": "object",
        "properties": {
          "order": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}